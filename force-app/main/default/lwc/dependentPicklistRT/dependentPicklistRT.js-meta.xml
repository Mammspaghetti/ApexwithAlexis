<?xml version="1.0" encoding="UTF-8"?>

<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">

    <apiVersion>65.0</apiVersion>

    <isExposed>true</isExposed>

    <masterLabel>
        Dependent Picklist RT
    </masterLabel>

    <description>
        Dependent picklists filtered by Record Type
    </description>

    <targets>

        <target>
            lightning__FlowScreen
        </target>

    </targets>

    <targetConfigs>

        <targetConfig targets="lightning__FlowScreen">


            <property
                name="objectApiName"
                type="String"
                label="Object API Name"
                role="inputOnly"
                required="true"/>


            <property
                name="recordTypeId"
                type="String"
                label="Record Type ID"
                role="inputOnly"
                required="true"/>


            <property
                name="controllingFieldApiName"
                type="String"
                label="Controlling Field API Name"
                role="inputOnly"
                required="true"/>


            <property
                name="dependentFieldApiName"
                type="String"
                label="Dependent Field API Name"
                role="inputOnly"
                required="true"/>


            <property
                name="defaultControllingValue"
                type="String"
                label="Default Controlling Value"
                description="Valeur sélectionnée par défaut dans la picklist contrôlante"
                role="inputOnly"/>


            <property
                name="defaultDependentValue"
                type="String"
                label="Default Dependent Value"
                description="Valeur sélectionnée par défaut dans la picklist dépendante"
                role="inputOnly"/>


            <property
                name="controllingValue"
                type="String"
                label="Controlling Value"
                role="outputOnly"/>


            <property
                name="dependentValue"
                type="String"
                label="Dependent Value"
                role="outputOnly"/>


            <property
                name="required"
                type="Boolean"
                label="Required"
                role="inputOnly"
                default="false"/>


        </targetConfig>

    </targetConfigs>

</LightningComponentBundle>