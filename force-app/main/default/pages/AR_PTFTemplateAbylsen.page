    <table class="abyv-toc2"><col/><col style="width:20pt;"/><tr><td class="abyv-toc-lbl"><span class="abyv-toc-n2">3-</span>Proposition Technique et Qualité <span class="abyv-toc-dots">........................................................................................................................................................................................................</span></td><td class="abyv-toc-pg"><a href="#toc-sec-prop"></a></td></tr></table>
    <table class="abyv-toc2"><col/><col style="width:20pt;"/><tr><td class="abyv-toc-lbl"><span class="abyv-toc-n2">4-</span>Conditions financières <span class="abyv-toc-dots">........................................................................................................................................................................................................</span></td><td class="abyv-toc-pg"><a href="#toc-sec-cond"></a></td></tr></table>
    <table class="abyv-toc1"><col/><col style="width:20pt;"/><tr><td class="abyv-toc-lbl"><span class="abyv-toc-n1">II-</span>CONDITIONS GENERALES <span class="abyv-toc-dots">........................................................................................................................................................................................................</span></td><td class="abyv-toc-pg"><a href="#toc-sec-ii"></a></td></tr></table>
    <table class="abyv-toc2"><col/><col style="width:20pt;"/><tr><td class="abyv-toc-lbl"><span class="abyv-toc-n2">1-</span>Définitions <span class="abyv-toc-dots">........................................................................................................................................................................................................</span></td><td class="abyv-toc-pg"><a href="#cg-art-1"></a></td></tr></table>
    <table class="abyv-toc2"><col/><col style="width:20pt;"/><tr><td class="abyv-toc-lbl"><span class="abyv-toc-n2">2-</span>Force contractuelle <span class="abyv-toc-dots">........................................................................................................................................................................................................</span></td><td class="abyv-toc-pg"><a href="#cg-art-2"></a></td></tr></table>
