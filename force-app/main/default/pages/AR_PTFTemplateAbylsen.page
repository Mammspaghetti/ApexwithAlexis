<apex:page controller="AR_PTFTemplateController"
  renderAs="pdf"
  applyBodyTag="false"
  applyHtmlTag="false"
  showHeader="false"
  sidebar="false"
  standardStylesheets="false"
  cache="false"
  docType="html-5.0"
>
<!--
  Gabarit ABYLSEN_AT_V11 — reconstruit en session 128 pour être IDENTIQUE au modèle validé par les
  équipes juridiques du client : docs/gabarits/SIGMA__PTF_AT_v11_FR.docx et son rendu
  docs/gabarits/SIGMA__PTF_AT_v11_FR1-modele-vierge.pdf. Méthode, écarts résiduels et historique :
  docs/128-ptf-abylsen-iso-modele.md (les notes des sessions 36 à 127 restent dans docs/, ce fichier
  ne les recopie plus).

  Règles de ce gabarit :
  - Texte statique = texte du .docx, caractère pour caractère (apostrophes droites ou courbes, espaces
    insécables, coquilles du modèle comprises : « Dispositives diverses », « Prestations.Le »,
    « Relation Client- Prestataire »…). La Section II est GÉNÉRÉE depuis le .docx
    (scripts/ptf/abylsen-v11/build.py) et contrôlée par scripts/check-ptf-cg-articles-vs-docx.js.
  - Mise en page = mesures du PDF modèle, en points. Marges, en-tête et pied courants : @page +
    éléments « running » (feuille AR_PTFStyleAbylsenV11).
  - Rappels des pièges déjà payés : tout champ consommé ici est une propriété avec accesseurs sur le
    contrôleur ; SPLIT() n'est pas reconnu ; AR_PTFTemplateController rend une page VIDE en cas
    d'erreur de désérialisation — jamais de champ renommé/retypé sur AR_PTFData, seulement des ajouts ;
    font-weight en style inline ne s'imprime pas : gras toujours par classe (.w-b).
-->
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<apex:stylesheet value="{!URLFOR($Resource.AR_PTFStyleAbylsenV11)}" />
</head>
<body>

<!-- ═══ En-tête et pied courants (pages 2 et suivantes), placés dans les marges par @page ═══ -->
<div class="abyv-header">
  <div class="abyv-rel">
    <img class="abyv-header-img" src="{!URLFOR($Resource.AR_PTFAbylsenAssets, 'aby-content-header.jpg')}" alt="" />
    <apex:outputPanel rendered="{!ptf.isPreview}" layout="none">
      <div class="abyv-preview">PREVIEW: non-contractual and unregistered document</div>
    </apex:outputPanel>
  </div>
</div>
<div class="abyv-footer">
  <div class="abyv-f-brand">ABYLSEN</div>
  <div class="abyv-f-conf">Les informations renseignées sur ce document sont strictement confidentielles. Elles ne doivent en aucun cas être diffusées ou traitées en dehors d’Abylsen ou du client concerné par le projet.</div>
  <div class="abyv-f-ref">Référence document interne :<apex:outputText value=" {!ptf.reference}" /></div>
  <div class="abyv-f-num"><span></span></div>
</div>

<!-- ═══════════════════════════ PAGE DE GARDE ═══════════════════════════ -->
<div class="abyv-cover">
  <img class="abyv-cov-banner" src="{!URLFOR($Resource.AR_PTFAbylsenAssets, 'aby-cover-header.jpg')}" alt="" />
  <div class="abyv-cov-title">PROPOSITION<br/>TECHNIQUE ET<br/>FINANCIERE</div>

  <!-- Tableau d'identification. Référence PTF : format interne (PTF-MAT-…-V<n>) tant que la
       nomenclature du modèle (ABYLSEN_PTF_NomClient_InitialesConsultant_Date) n'est pas arbitrée. -->
  <table class="abyv-ident">
    <col style="width:92.1pt;"/><col style="width:219.8pt;"/><col style="width:92.3pt;"/><col/>
    <tr>
      <td class="k">Référence PTF</td>
      <td class="v" colspan="3"><apex:outputText value="{!ptf.reference}" /></td>
    </tr>
    <tr>
      <td class="k">Client</td>
      <td class="v" colspan="3"><apex:outputText value="{!ptf.client}" /></td>
    </tr>
    <tr>
      <td class="k">Projet</td>
      <td class="v"><apex:outputText value="{!ptf.titreBesoin}" /></td>
      <td class="k2">Version numéro</td>
      <td class="v"><apex:outputText value="{!versionNumeroLabel}" /></td>
    </tr>
  </table>

  <div class="abyv-cov-body">
    <div class="abyv-rule abyv-rule-first"></div>
    <table class="abyv-grid">
      <tr>
        <td class="h" style="width:241.1pt;">Rédacteur<br/>(nom/prénom/fonction)</td>
        <td class="h">Valideur<br/>(nom/prénom/fonction)</td>
      </tr>
      <tr>
        <td class="b">
          <apex:outputText value="{!ptf.redacteurNom}" />
          <apex:outputText value=" — {0}" rendered="{!NOT(ISBLANK(ptf.redacteurFonction))}"><apex:param value="{!ptf.redacteurFonction}" /></apex:outputText>
        </td>
        <td class="b">
          <apex:outputText value="{!IF(ISBLANK(ptf.valideurNom), '', ptf.valideurNom + ' ')}" />
          <apex:outputText value=" — {0}" rendered="{!NOT(ISBLANK(ptf.valideurFonction))}"><apex:param value="{!ptf.valideurFonction}" /></apex:outputText>
        </td>
      </tr>
      <tr><td class="b"></td><td class="b"></td></tr>
      <tr><td class="b"></td><td class="b"></td></tr>
    </table>

    <div class="abyv-rule"></div>
    <table class="abyv-grid">
      <tr>
        <td class="h" style="width:241.1pt;">Interlocuteurs CLIENT</td>
        <td class="h">Fonctions / coordonnées</td>
      </tr>
      <tr>
        <td class="b"><apex:outputText value="{!IF(ISBLANK(ptf.interNom), '', ptf.interNom + ' ')}" /></td>
        <td class="b">
          <apex:outputText value="{!IF(ISBLANK(ptf.interFonction), '', ptf.interFonction + ' ')}" />
          <apex:outputPanel rendered="{!NOT(ISBLANK(ptf.interTel))}" layout="none"><br/><apex:outputText value="{!ptf.interTel}" /></apex:outputPanel>
          <apex:outputPanel rendered="{!NOT(ISBLANK(ptf.interEmail))}" layout="none"><br/><apex:outputText value="{!ptf.interEmail}" /></apex:outputPanel>
        </td>
      </tr>
      <tr><td class="b"></td><td class="b"></td></tr>
      <tr><td class="b"></td><td class="b"></td></tr>
    </table>

    <!-- Historique des modifications (session 138) : une ligne par version cochée du périmètre, plus la
         ligne en cours, figées dans le snapshot (AR_PTFData.historique) — aucune ligne vide de
         remplissage. La garde a une hauteur fixe : seules les lignes qui y tiennent sont ici
         (historiqueCoverRows), la suite est sur la page de continuation qui suit la garde.
         Session 151 : ne pas afficher le bloc historique si c’est une V01. -->
    <apex:outputPanel layout="none" rendered="{!showHistorique}">
    <div class="abyv-rule"></div>
    <table class="abyv-grid abyv-hist">
      <col style="width:113.5pt;"/><col style="width:113.3pt;"/><col style="width:120.6pt;"/><col/>
      <tr><td class="h" colspan="4">Historique des modifications</td></tr>
      <tr>
        <td class="h c">Version</td>
        <td class="h c">Date d’émission</td>
        <td class="h c">Modification</td>
        <td class="h c">Responsable de la modification</td>
      </tr>
      <apex:repeat value="{!historiqueCoverRows}" var="hrow">
        <tr>
          <td class="b c"><apex:outputText value="{!hrow.version}" /></td>
          <td class="b c"><apex:outputText value="{!hrow.dateLabel}" /></td>
          <td class="b c"><apex:outputText value="{!hrow.objetModification}" /></td>
          <td class="b c"><apex:outputText value="{!hrow.responsable}" /></td>
        </tr>
      </apex:repeat>
    </table>
    </apex:outputPanel>

    <!-- Adresses : libellés « Client : », « Adresse : », « SIRET : » toujours imprimés, comme le modèle.
         Entité en capitales (« Adresse ABYLSEN SIGMA »), comme le modèle. -->
    <div class="abyv-rule"></div>
    <table class="abyv-grid">
      <tr>
        <td class="h" style="width:241.1pt;">Nom et adresse du CLIENT</td>
        <td class="h">Adresse <span class="w-up"><apex:outputText value="{!ptf.entite}" /></span></td>
      </tr>
      <tr>
        <td class="b tall">
          <br/>
          <apex:outputText value="Client : {0}"><apex:param value="{!ptf.client}" /></apex:outputText><br/>
          <span class="w-pre"><apex:outputText value="Adresse : {0}"><apex:param value="{!ptf.adresseClient}" /></apex:outputText></span><br/>
          <apex:outputText value="SIRET : {0}"><apex:param value="{!ptf.siretClient}" /></apex:outputText>
        </td>
        <td class="b tall">
          <br/>
          <span class="w-up"><apex:outputText value="{!ptf.entite}" /></span><br/>
          <span class="w-pre"><apex:outputText value="{!ptf.entiteInfo.adresse}" /></span><br/>
          <br/>
          <br/>
          <apex:outputText value="SIRET : {0}"><apex:param value="{!ptf.entiteInfo.siret}" /></apex:outputText>
        </td>
      </tr>
    </table>
  </div>

  <img class="abyv-cov-footer" src="{!URLFOR($Resource.AR_PTFAbylsenAssets, 'aby-cover-footer.jpg')}" alt="" />
  <apex:outputPanel rendered="{!ptf.isPreview}" layout="none">
    <div class="abyv-preview">PREVIEW: non-contractual and unregistered document</div>
  </apex:outputPanel>
</div>

<!-- ═══════════ SUITE DE L'HISTORIQUE (uniquement si la garde n'a pas pu tout contenir) ═══════════ -->
<!-- Page en flux normal, après la garde (qui force son propre saut de page) : en-têtes répétés si la
     suite déborde, une ligne ne se coupe jamais entre deux pages. Le saut de page final renvoie le
     sommaire sur sa propre page. Conteneur à largeur fixe : même contournement que le sommaire.
     Session 151 : ne pas afficher si c'est une V01 (showHistorique=false). -->
<apex:outputPanel layout="none" rendered="{!AND(showHistorique, hasHistoriqueSuite)}">
<div class="abyv-content abyv-hist-suite-page">
  <table class="abyv-grid abyv-hist abyv-hist-suite">
    <col style="width:80pt;"/><col style="width:100pt;"/><col style="width:140pt;"/><col/>
    <thead>
      <tr><td class="h" colspan="4">Historique des modifications (suite)</td></tr>
      <tr>
        <td class="h c">Version</td>
        <td class="h c">Date d’émission</td>
        <td class="h c">Modification</td>
        <td class="h c">Responsable de la modification</td>
      </tr>
    </thead>
    <tbody>
      <apex:repeat value="{!historiqueSuiteRows}" var="srow">
        <tr>
          <td class="b c"><apex:outputText value="{!srow.version}" /></td>
          <td class="b c"><apex:outputText value="{!srow.dateLabel}" /></td>
          <td class="b c"><apex:outputText value="{!srow.objetModification}" /></td>
          <td class="b c"><apex:outputText value="{!srow.responsable}" /></td>
        </tr>
      </apex:repeat>
    </tbody>
  </table>
</div>
</apex:outputPanel>

