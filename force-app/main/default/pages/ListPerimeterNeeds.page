<apex:page standardController="Account"
           extensions="AccountNeedsPerimetreCtrl"
           showHeader="true"
           sidebar="true"
           lightningStylesheets="true">

    <apex:form >
        <apex:pageMessages />

        <apex:pageBlock mode="maindetail">
        
        
            <apex:pageBlockSection columns="1">
                <apex:outputText value="{!$Label.ABY_VFP_Perimeter_list_Number_of_needs}: {!totalSize}" />
            </apex:pageBlockSection>



            <apex:pageBlockTable value="{!Needs}" var="c" rendered="{!totalSize > 0}">
                <apex:column headerValue="{!$Label.ABY_VFP_Perimeter_list_Name}">
                    <apex:outputLink value="/{!c.Id}">{!c.Name}</apex:outputLink>
                </apex:column>
                <apex:column value="{!c.Priorit__c}" headerValue="{!$Label.ABY_VFP_Perimeter_list_Priority}" />
                <apex:column value="{!c.TP_Niveau_d_engagement_Abylsen__c}" headerValue="{!$Label.ABY_VFP_Perimeter_list_Commitment_level}" />
                <apex:column headerValue="{!$Label.ABY_VFP_Perimeter_list_Contact}">
                     <apex:outputLink value="/{!c.AB_Need_details__r.AB_Contact__c}">{!c.AB_Contact__c}</apex:outputLink>
                 </apex:column>
                <apex:column value="{!c.cxsrec__Status__c}" headerValue="{!$Label.ABY_VFP_Perimeter_list_Status}" />
                <apex:column value="{!c.CreatedDate}" headerValue="{!$Label.ABY_VFP_Perimeter_list_Created_date}" />
            </apex:pageBlockTable>

            <apex:outputPanel rendered="{!totalSize == 0}">
                <apex:pageMessage severity="info"
                                  summary="{!$Label.ABY_VFP_Perimeter_list_No_needs}"
                                  detail=""/>
            </apex:outputPanel>


        <apex:outputPanel id="pb" />
        </apex:pageblock>
    </apex:form>
</apex:page>